  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token de operador para escritura; operador o integración para GET."
      },
      "deviceKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Device-Key"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "DeviceInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "site": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "minimum": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "maximum": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          }
        },
        "required": [
          "name",
          "site",
          "minimum",
          "maximum"
        ]
      },
      "ReadingInput": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "temperature": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "description": "Ventana: últimas 24 h hasta 5 min futuros; zona horaria obligatoria."
          }
        },
        "required": [
          "event_id",
          "device_id",
          "temperature",
          "observed_at"
        ]
      },
      "Device": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "site": {
            "type": "string"
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          },
          "active": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "last_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_temperature": {
            "type": [
              "number",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "SIN DATOS",
              "NORMAL",
              "ALTA",
              "BAJA"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "site",
          "minimum",
          "maximum",
          "active",
          "last_at",
          "last_temperature",
          "state"
        ]
      },
      "Alert": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "device_name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ALTA",
              "BAJA"
            ]
          },
          "temperature": {
            "type": "number"
          },
          "opened_at": {
            "type": "string",
            "format": "date-time"
          },
          "resolved_at": {
            "type": [
              "string",
              "null"
            ],
